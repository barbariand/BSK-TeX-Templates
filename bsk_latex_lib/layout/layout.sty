\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/layout/layout}[2025/11/18 v1.4 Layout Module]

\RequirePackage[swedish, english]{babel}
\RequirePackage{times}
\RequirePackage[utf8]{inputenc}
\RequirePackage{geometry}
\geometry{a4paper, portrait, lmargin=3cm, rmargin=3cm, tmargin=4cm}
\RequirePackage{lastpage}
\RequirePackage{xparse}
\RequirePackage{fancyhdr}
\RequirePackage{array}
\RequirePackage{graphicx}
\RequirePackage{background}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% --- Header och Footer ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

% Här hämtar vi den dynamiska titeln
\lhead{\bskDocumentTitle}

\rhead{\meetingDatum}
\rfoot{Justeras: \underline{\qquad\quad}\qquad\thepage \: (\pageref{LastPage})}
\cfoot{\includegraphics[width=2.5cm]{\meetingLogga}}

% --- Ram ---
\newcommand{\SetPageBorder}{
  \backgroundsetup{color=black,scale=1,opacity=1,angle=0,
  contents={\tikz\draw[line width=3pt,draw=\meetingFarg]
    ( $ (current page.south east) +(-13,2) $ ) -- ( $ (current page.south west) +(1.75 ,2) $ )
    ( $ (current page.south west) +(2,1) $ ) -- ( $ (current page.north west) +(2,-1.75) $ )
    ( $ (current page.north west) +(1.75,-2) $ ) -- ( $ (current page.north east) -(2,2) $ ); }}
}

\AtBeginDocument{\SetPageBorder}
