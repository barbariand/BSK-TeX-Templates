\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/layout/layout}[2025/11/18 v0.1.0 Layout Module]

\RequirePackage[swedish, english]{babel}
\RequirePackage{times}
\RequirePackage[utf8]{inputenc}
\RequirePackage{geometry}
\geometry{
  a4paper,
  portrait,
  lmargin=3cm,
  rmargin=3cm,
  tmargin=4cm,
  headheight=25pt,
  headsep=20pt,
  footskip=80pt
}

\RequirePackage[lastpage,user]{zref}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% --- Header och Footer ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

\lhead{\bskDocumentTitle}
\rhead{\meetingDatum}
\rfoot{\thepage \: (\zref[page]{LastPage})}
\cfoot{\includegraphics[width=2.5cm]{\meetingLogga}}

% --- Ram ---
\newcommand{\SetPageBorder}{
  \AddToHook{shipout/background}{
    \tikz[remember picture, overlay]\draw[line width=3pt,draw=\meetingFarg]
      ( $ (current page.south east) +(-12.5, 2.0) $ ) -- ( $ (current page.south west) +(1.75 , 2.0) $ )
      ( $ (current page.south west) +(2, 1.75) $ ) -- ( $ (current page.north west) +(2, -1.75) $ )
      ( $ (current page.north west) +(1.75, -2) $ ) -- ( $ (current page.north east) -(2, 2) $ );
  }
}

\AtBeginDocument{\SetPageBorder}
