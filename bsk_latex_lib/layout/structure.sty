\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/layout/structure}[2025/09/27 v0.1.0 Structure Module]

% --- Nödvändiga paket ---
\RequirePackage{float}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{xparse}
\RequirePackage{tabularx}
\RequirePackage{colortbl} % Hanterar färgerna

% ---------------------------------------------------------
% 1. PARAGRAF (Normal storlek, ingen färg)
% ---------------------------------------------------------
\newcounter{paragrafcounter}

\NewDocumentCommand{\paragraf}{s +m +m}{%
    \par\vspace{0.5em}\noindent
    \IfBooleanF{#1}{\stepcounter{paragrafcounter}}%
    \begingroup
    \renewcommand\arraystretch{1.3}%
    \begin{tabular}{ @{} p{1.5cm} p{4cm} p{9.5cm} @{} }
        \IfBooleanTF{#1}{}{%
            \textbf{§\theparagrafcounter}%
        }
        & \raggedright \textbf{#2}
        & \begin{minipage}[t]{\linewidth}
            \raggedright
            #3
        \end{minipage}
    \end{tabular}
    \endgroup
    \par\vspace{0.5em}
}

% ---------------------------------------------------------
% 2. NOTE (Liten storlek, varannan rad grå/vit)
% ---------------------------------------------------------
\newcounter{notecounter}

\NewDocumentCommand{\note}{s O{0.5em} +m +m}{%
    \par\noindent%
    \IfBooleanF{#1}{\stepcounter{notecounter}}%
    \begingroup
    \renewcommand\arraystretch{1.3}%
    \small
    \begin{tabularx}{\linewidth}{ @{} p{0.85cm} X @{} }
        \ifodd\value{notecounter}
            \rowcolor{gray!15}
        \else
            \rowcolor{white}
        \fi

        \IfBooleanTF{#1}{}{%
            \textbf{§\thenotecounter}%
        } &

        \raggedright
        \textbf{#3} \newline
        \begin{minipage}[t]{\linewidth}
            \raggedright
            #4
        \end{minipage}
        \tabularnewline[#2]

    \end{tabularx}
    \endgroup
    \par\nointerlineskip
}
