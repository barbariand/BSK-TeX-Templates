\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/bsk_formalia}[2025/09/27 v8.0 Formalia Module]

\RequirePackage{xparse}

\ExplSyntaxOn

% --- Variable Declarations ---
\tl_new:N \g_bsk_present_list_tl
\tl_new:N \g_bsk_absent_list_tl
\prop_new:N \g_bsk_officials_prop
\tl_new:N \l__bsk_person_name_tl
\tl_new:N \l__bsk_person_role_tl
\tl_new:N \l__bsk_attendance_note_tl
\tl_new:N \l__bsk_attendance_name_tl
\tl_new:N \l__bsk_attendance_role_tl

% --- Key Definitions ---
\keys_define:nn { bsk/person }
{
  name .tl_set:N  = \l__bsk_person_name_tl,
  role .tl_set:N  = \l__bsk_person_role_tl,
}
\keys_define:nn { bsk/attendance }
{
  note .tl_set:N = \l__bsk_attendance_note_tl,
}

% --- Internal Functions ---
\cs_new_protected:Npn \__bsk_new_person:nn #1#2
{
  \prop_new:c { g_bsk_person_ \cs_to_str:N #1 _prop }
  \keys_set:nn { bsk/person } { #2 }
  \prop_gput:cnV { g_bsk_person_ \cs_to_str:N #1 _prop } { name } \l__bsk_person_name_tl
  \prop_gput:cnV { g_bsk_person_ \cs_to_str:N #1 _prop } { role } \l__bsk_person_role_tl
}

\cs_new_protected:Npn \__bsk_add_attendance:Nno #1#2#3
{
  \prop_get:cnN { g_bsk_person_ \cs_to_str:N #2 _prop } { name } \l__bsk_attendance_name_tl
  \prop_get:cnN { g_bsk_person_ \cs_to_str:N #2 _prop } { role } \l__bsk_attendance_role_tl
  \tl_set:Nn \l__bsk_attendance_note_tl {}
  \keys_set:nn { bsk/attendance } { #3 }
  \tl_gput_right:Nx #1
  {
    \tl_use:N \l__bsk_attendance_name_tl & \tl_use:N \l__bsk_attendance_role_tl
    \tl_if_empty:NF \l__bsk_attendance_note_tl { ~ ( \tl_use:N \l__bsk_attendance_note_tl ) }
    \\
  }
}

\cs_new_protected:Npn \__bsk_set_officials:nnn #1#2#3
{
  \prop_gput:cnV { g_bsk_officials_prop } { ordf_name } { \prop_get:cn { g_bsk_person_ \cs_to_str:N #1 _prop } { name } }
  \prop_gput:cnV { g_bsk_officials_prop } { sekr_name } { \prop_get:cn { g_bsk_person_ \cs_to_str:N #2 _prop } { name } }
  \prop_gput:cnV { g_bsk_officials_prop } { just_name } { \prop_get:cn { g_bsk_person_ \cs_to_str:N #3 _prop } { name } }
  \__bsk_add_attendance:Nno \g_bsk_present_list_tl {#1} {}
  \__bsk_add_attendance:Nno \g_bsk_present_list_tl {#2} {}
  \__bsk_add_attendance:Nno \g_bsk_present_list_tl {#3} {}
}

% --- User-Facing Commands ---
\NewDocumentCommand{\newperson}{ m m }
  { \__bsk_new_person:nn {#1} {#2} }

\NewDocumentCommand{\setMeetingOfficials}{ m m m }
  { \__bsk_set_officials:nnn {#1} {#2} {#3} }

\NewDocumentCommand{\addPresent}{ m O{} }
  { \__bsk_add_attendance:Nno \g_bsk_present_list_tl {#1} {#2} }

\NewDocumentCommand{\addAbsent}{ m O{} }
  { \__bsk_add_attendance:Nno \g_bsk_absent_list_tl {#1} {#2} }

\NewDocumentCommand{\clearAttendance}{ }
{
  \tl_gclear:N \g_bsk_present_list_tl
  \tl_gclear:N \g_bsk_absent_list_tl
  \prop_gclear:N \g_bsk_officials_prop
}

\NewDocumentCommand{\present}{ }
  { \paragraf{}{ \textbf{Närvarande:} }{ \begin{tabular}{ll} \tl_use:N \g_bsk_present_list_tl \end{tabular} } }

\NewDocumentCommand{\absent}{ }
  { \paragraf{}{ \textbf{Frånvarande:} }{ \begin{tabular}{ll} \tl_use:N \g_bsk_absent_list_tl \end{tabular} } }

\NewDocumentCommand{\signatures}{ }
{
  \begin{table}[H]
  \noindent\begin{tabular}{ll}
  \makebox[2.5in]{} & \makebox[2.5in]{}\\[8ex]
  \makebox[2.5in]{\hrulefill} & \makebox[2.5in]{\hrulefill}\\
  Mötesordförande & Datum\\
  \prop_get:Nn \g_bsk_officials_prop { ordf_name } \\[8ex]
  \makebox[2.5in]{\hrulefill} & \makebox[2.5in]{\hrulefill}\\
  Mötessekreterare & Datum\\
  \prop_get:Nn \g_bsk_officials_prop { sekr_name } \\[8ex]
  \makebox[2.5in]{\hrulefill} & \makebox[2.5in]{\hrulefill}\\
  Justerare & Datum\\
  \prop_get:Nn \g_bsk_officials_prop { just_name } \\
  \end{tabular}
  \end{table}
}
\ExplSyntaxOff
