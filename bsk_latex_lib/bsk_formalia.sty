\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/bsk_formalia}[2025/09/27 v10.1 Formalia Module (Intuitive, Corrected)]

\RequirePackage{xparse}

\ExplSyntaxOn

% --- Data Storage ---
\prop_new:N \g_bsk_officials_prop
\seq_new:N  \g_bsk_present_seq
\seq_new:N  \g_bsk_absent_seq
\tl_new:N   \l__bsk_person_name_tl
\tl_new:N   \l__bsk_person_role_tl
\tl_new:N   \l__bsk_temp_name_tl
\tl_new:N   \l__bsk_temp_role_tl

% --- Key Definitions for \newperson ---
\keys_define:nn { bsk/person }
 {
  name .tl_set:N = \l__bsk_person_name_tl,
  name .default:n = \c_novalue,
  role .tl_set:N = \l__bsk_person_role_tl,
 }

% --- User Command: \newperson ---
\NewDocumentCommand{\newperson}{m m}
 {
  \prop_new:c {g_bsk_person_ \cs_to_str:N #1 _prop}
  \keys_set:nn { bsk/person } { name = \cs_to_str:N #1 }
  \keys_set:nn { bsk/person } {#2}
  \prop_gput:cnV {g_bsk_person_ \cs_to_str:N #1 _prop} {name} \l__bsk_person_name_tl
  \prop_gput:cnV {g_bsk_person_ \cs_to_str:N #1 _prop} {role} \l__bsk_person_role_tl
 }

\NewDocumentCommand{\setMeetingOfficials}{m m m}
 {
  \prop_gput:Nn \g_bsk_officials_prop {ordf_name}
    { \prop_item:cn {g_bsk_person_ \cs_to_str:N #1 _prop} {name} }
  \prop_gput:Nn \g_bsk_officials_prop {sekr_name}
    { \prop_item:cn {g_bsk_person_ \cs_to_str:N #2 _prop} {name} }
  \prop_gput:Nn \g_bsk_officials_prop {just_name}
    { \prop_item:cn {g_bsk_person_ \cs_to_str:N #3 _prop} {name} }
 }

% --- User Commands: \addPresent and \addAbsent ---
\NewDocumentCommand{\addPresent}{m}
 {
  \seq_gput_right:Nn \g_bsk_present_seq {#1}
 }
\NewDocumentCommand{\addAbsent}{m}
 {
  \seq_gput_right:Nn \g_bsk_absent_seq {#1}
 }

% --- User Command: \clearAttendance ---
\NewDocumentCommand{\clearAttendance}{}
 {
  \prop_gclear:N \g_bsk_officials_prop
  \seq_gclear:N \g_bsk_present_seq
  \seq_gclear:N \g_bsk_absent_seq
 }

\cs_new_protected:Npn \__bsk_build_attendance_table:N #1
 {
  \begin{tabular}{ll}
   \seq_map_inline:Nn #1
    {
     \prop_get:cnN {g_bsk_person_ \cs_to_str:N ##1 _prop} {name} \l__bsk_temp_name_tl
     \prop_get:cnN {g_bsk_person_ \cs_to_str:N ##1 _prop} {role} \l__bsk_temp_role_tl
     \l__bsk_temp_name_tl & \l__bsk_temp_role_tl \\
    }
  \end{tabular}
 }

% --- User Commands to PRINT attendance ---
\NewDocumentCommand{\present}{}
 {
  \seq_if_empty:NF \g_bsk_present_seq {
    \paragraf{}{\textbf{Närvarande:}}{ % Changed to Swedish for consistency
     \__bsk_build_attendance_table:N \g_bsk_present_seq
    }
  }
 }
\NewDocumentCommand{\absent}{}
 {
  \seq_if_empty:NF \g_bsk_absent_seq {
    \paragraf{}{\textbf{Frånvarande:}}{ % Changed to Swedish for consistency
     \__bsk_build_attendance_table:N \g_bsk_absent_seq
    }
  }
 }

% --- User Commands for Signatures ---
\NewExpandableDocumentCommand{\getOfficial}{m}
 {
  \prop_item:Nn \g_bsk_officials_prop {#1}
 }

\NewDocumentCommand{\signatures}{ }
 {
  \begin{table}[H]
  \noindent\begin{tabular}{ll}
  \makebox[2.5in]{} & \makebox[2.5in]{}\\[8ex]
  \makebox[2.5in]{\hrulefill} & \makebox[2.5in]{\hrulefill}\\
  Mötesordförande & Datum\\ % Changed to Swedish
  \getOfficial{ordf_name} \\[8ex]
  \makebox[2.5in]{\hrulefill} & \makebox[2.5in]{\hrulefill}\\
  Mötessekreterare & Datum\\ % Changed to Swedish
  \getOfficial{sekr_name} \\[8ex]
  \makebox[2.5in]{\hrulefill} & \makebox[2.5in]{\hrulefill}\\
  Justerare & Datum\\ % Changed to Swedish
  \getOfficial{just_name} \\
  \end{tabular}
  \end{table}
 }

\ExplSyntaxOff
