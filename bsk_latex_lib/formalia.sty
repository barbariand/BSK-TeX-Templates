\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk}[2025/09/26 v4.1 BSK Protocol Helper]

\ExplSyntaxOn

% --- Variable and List Declarations ---
\tl_new:N \g_bsk_present_list_tl
\tl_new:N \g_bsk_absent_list_tl
% Temporary variables for building the table row
\tl_new:N \l_bsk_attendance_name_tl
\tl_new:N \l_bsk_attendance_role_tl
\tl_new:N \l_bsk_attendance_note_tl

% --- Person Definition System (Key-Value) ---
\keys_define:nn { bsk/person }
{
  name .tl_set:N  = \l_bsk_person_name_tl,
  role .tl_set:N  = \l_bsk_person_role_tl,
}

\NewDocumentCommand{\newperson}{ m m }
{You wanna
  \prop_new:c { g_bsk_person_ \cs_to_str:N #1 _prop }
  \keys_set:nn { bsk/person } { #2 }
  \prop_gput:cnV { g_bsk_person_ \cs_to_str:N #1 _prop } { name } \l_bsk_person_name_tl
  \prop_gput:cnV { g_bsk_person_ \cs_to_str:N #1 _prop } { role } \l_bsk_person_role_tl
}

% --- Attendance System ---
\keys_define:nn { bsk/attendance }
{
  role .tl_set:N = \l_bsk_attendance_role_tl,
  note .tl_set:N = \l_bsk_attendance_note_tl,
}

\NewDocumentCommand{\addPresent}{ m O{} }
{
  \prop_get:cnN { g_bsk_person_ \cs_to_str:N #1 _prop } { name } \l_bsk_attendance_name_tl
  \prop_get:cnN { g_bsk_person_ \cs_to_str:N #1 _prop } { role } \l_bsk_attendance_role_tl
  \tl_clear:N \l_bsk_attendance_note_tl
  \keys_set:nn { bsk/attendance } { #2 }

  \tl_gput_right:Nx \g_bsk_present_list_tl
  {
    \l_bsk_attendance_name_tl
    &
    \l_bsk_attendance_role_tl
    \tl_if_empty:NF \l_bsk_attendance_note_tl { ~(\l_bsk_attendance_note_tl) }
    \\
  }
}

\NewDocumentCommand{\addAbsent}{ m O{} }
{
  \prop_get:cnN { g_bsk_person_ \cs_to_str:N #1 _prop } { name } \l_bsk_attendance_name_tl
  \prop_get:cnN { g_bsk_person_ \cs_to_str:N #1 _prop } { role } \l_bsk_attendance_role_tl
  \tl_clear:N \l_bsk_attendance_note_tl
  \keys_set:nn { bsk/attendance } { #2 }

  \tl_gput_right:Nx \g_bsk_absent_list_tl
  {
    \l_bsk_attendance_name_tl
    &
    \l_bsk_attendance_role_tl
    \tl_if_empty:NF \l_bsk_attendance_note_tl { ~(\l_bsk_attendance_note_tl) }
    \\
  }
}

% --- Meeting Official and Formalia Commands ---
\NewDocumentCommand{\setMeetingOfficials}{ m m m }
{
  \addPresent{#1}
  \addPresent{#2}
  \addPresent{#3}
}

\NewDocumentCommand{\clearAttendance}{ }
{
  \tl_gclear:N \g_bsk_present_list_tl
  \tl_gclear:N \g_bsk_absent_list_tl
}

\NewDocumentCommand{\present}{ }
{
  \paragraf{}{
    \textbf{Närvarande:}}{
      \begin{tabular}{ll}
        \tl_use:N \g_bsk_present_list_tl
      \end{tabular}}
}

\NewDocumentCommand{\absent}{ }
{
  \paragraf{}{
    \textbf{Frånvarande:}}{
      \begin{tabular}{ll}
        \tl_use:N \g_bsk_absent_list_tl
      \end{tabular}}
}
\ExplSyntaxOff
