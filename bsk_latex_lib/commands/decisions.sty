\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/commands/decisions}[2025/09/27 v4.3 Starred YrkandeBeslut]

\RequirePackage{xparse}

\ExplSyntaxOn

\seq_new:N \g_bsk_complex_decisions_seq
\seq_new:N \l_bsk_clauses_seq
\seq_new:N \l_bsk_outcomes_seq
\int_new:N \l_bsk_clause_int

% --- Hjälpfunktion för utfall ---
\cs_new_protected:Npn \__bsk_format_outcome:n #1
{
  \str_case:nnF {#1}
  {
    {bifall} { bifalla~yrkandet }
    {avslag} { avslå~yrkandet }
  }
  { #1 }
}

% --- Uppdaterat kommando: \YrkandeBeslut ---
% #1 = Stjärna (*) -> Om med, spara EJ till sammanfattning
% #2 = Separerare (Standard: ,)
% #3 = Person (t.ex. \ordfarande)
% #4 = Lista med att-satser
% #5 = Lista med utfall
\NewDocumentCommand{\YrkandeBeslut}{ s O{,} m m m }
{
  \group_begin:
  % Dela upp listorna baserat på vald separerare (#2)
  \seq_set_split:Nnn \l_bsk_clauses_seq { #2 } { #4 }
  \seq_set_split:Nnn \l_bsk_outcomes_seq { #2 } { #5 }

  \int_zero:N \l_bsk_clause_int

  % 1. Skriv ALLTID ut i protokollet (där kommandot körs)
  #3~yrkar~på~
  \seq_map_inline:Nn \l_bsk_clauses_seq
  {
    \int_incr:N \l_bsk_clause_int
    att~(\int_use:N \l_bsk_clause_int)~”##1”~
  }
  \par\addlinespace
  \noindent\textbf{Styrelsen~beslutade}
  \begin{itemize}
    \int_zero:N \l_bsk_clause_int
    \seq_map_inline:Nn \l_bsk_outcomes_seq
    {
      \int_incr:N \l_bsk_clause_int
      \item \textit{att}~(\int_use:N \l_bsk_clause_int)~\__bsk_format_outcome:n {##1}.
    }
  \end{itemize}

  % 2. Registrera i sammanfattningen BARA om ingen stjärna (*) finns
  \IfBooleanF {#1}
  {
    \seq_gput_right:Nx \g_bsk_complex_decisions_seq
    {
      { \int_use:N \c@paragrafcounter }
      { #3 }
      { #4 }
      { #5 }
      { #2 }
    }
  }
  \group_end:
}

% --- Formatering av sammanfattningen ---
\cs_new_protected:Npn \__bsk_print_summary_block:nnnnn #1 #2 #3 #4 #5
{
  \seq_set_split:Nnn \l_bsk_clauses_seq { #5 } { #3 }
  \seq_set_split:Nnn \l_bsk_outcomes_seq { #5 } { #4 }

  \item[\S#1] #2~yrkar~på~
  \int_zero:N \l_bsk_clause_int
  \seq_map_inline:Nn \l_bsk_clauses_seq
  {
    \int_incr:N \l_bsk_clause_int
    att~(\int_use:N \l_bsk_clause_int)~”##1”~
  }
  \\ \textbf{Styrelsen~beslutade}~
  \int_zero:N \l_bsk_clause_int
  \seq_map_inline:Nn \l_bsk_outcomes_seq
  {
    \int_incr:N \l_bsk_clause_int
    att~(\int_use:N \l_bsk_clause_int)~\__bsk_format_outcome:n {##1}
    \int_compare:nNnF { \l_bsk_clause_int } = { \seq_count:N \l_bsk_outcomes_seq } { ,~ }
  }
  .
}

\NewDocumentCommand{\printDecisionSummary}{}
{
  \seq_if_empty:NTF \g_bsk_complex_decisions_seq
  {
    \paragraf{Beslutssammanfattning}{Inga~beslut~togs.}
  }
  {
    \paragraf{Beslutssammanfattning}
    {
      Följande~beslut~har~fattats~under~mötet:
      \begin{itemize}
        \seq_map_inline:Nn \g_bsk_complex_decisions_seq
        { \__bsk_print_summary_block:nnnnn ##1 }
      \end{itemize}
    }
  }
}

\ExplSyntaxOff
