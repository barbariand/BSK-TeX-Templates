\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/commands/meeting}[2025/09/27 v1.13 Meeting Module]

\RequirePackage{xparse}

\ExplSyntaxOn

\cs_new_protected:Npn \__bsk_meeting_moetets_oppnande:
{
  \paragraf{Mötet~öppnas}{Mötesordförande~{\getOfficial{ordf_name}}~förklarade~mötet~öppnat.}
}

\cs_new_protected:Npn \__bsk_meeting_val_av_justerare:
{
  \paragraf{Val~av~mötesordförande,~mötessekreterare~samt~justeringsperson.}{
    \YrkandeBeslut*{
      att~välja~{\getOfficial{ordf_name}}~till~mötesordförande.,
      att~välja~{\getOfficial{sekr_name}}~till~mötessekreterare.,
      att~välja~{\getOfficial{just1_name}}~till~justeringsperson.
    }
    \prop_if_in:NnT \g_bsk_officials_prop {just2_name}
    {
      \Beslut*{ att~välja~{\getOfficial{just2_name}}~till~justeringsperson. }
    }
  }
}

% --- Samma som tidigare för övriga funktioner ---
\cs_new_protected:Npn \__bsk_meeting_moetets_behoriga_utlysande:
