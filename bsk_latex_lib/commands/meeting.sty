\cs_new_protected:Npn \__bsk_meeting_yttrande_och_rostratt:
{ \paragraf{Yttranderätt~och~rösträtt}{Samtliga~närvarande~medlemmar~i~Blekinge~studentkår~hade~närvaro-~samt~yttranderätt.~Ordinarie~styrelse~hade~rösträtt~vid~beslut.} }

\cs_new_protected:Npn \__bsk_meeting_faststallande_av_foredragningslista:
{ \paragraf{Fastställande~av~dagordning}{Dagordningen~fastställdes~enligt~utsänt~förslag.} }

\cs_new_protected:Npn \__bsk_meeting_faststallande_av_foregaende_protokoll:
{ \paragraf{Fastställande~av~föregående~mötesprotokoll}{Föregående~mötesprotokoll~lades~till~handlingarna.} }

\NewDocumentCommand{\printFormalia}{}
{
	\present \absent
	\subsection*{Formalia}
	\__bsk_meeting_moetets_oppnande:
	\__bsk_meeting_val_av_justerare:
	\__bsk_meeting_moetets_behoriga_utlysande:
	\__bsk_meeting_yttrande_och_rostratt:
	\__bsk_meeting_faststallande_av_foredragningslista:
	\__bsk_meeting_faststallande_av_foregaende_protokoll:
	\section*{Ärenden}
}

\NewDocumentCommand{\printClosing}{}
{
	\paragraf{Mötet avslutas}{\getOfficial{ordf_name}~avslutade~mötet~kl.~hh:mm.}
	\section*{Avslutning}
	\printDecisionSummary
	\signatures
}

