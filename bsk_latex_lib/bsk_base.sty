%%%% This is mostly importing important packages and set default settings.The comments are to explain what it is used for %%%%

% Language support
\RequirePackage[swedish, english]{babel}
% To switch to swedish
\newcommand{\swe}[\selectlanguage{swedish}]
% To switch to english
\newcommand{\eng}[\selectlanguage{english}]
% borders and such
\RequirePackage{geometry}
\geometry{a4paper, portrait, lmargin=3cm, rmargin=3cm, tmargin=4cm}
\RequirePackage{lastpage}
% other usefull packages for formatting
\RequirePackage{background}
\RequirePackage{times}
\RequirePackage{array}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lipsum}
\RequirePackage{float}
% multi line comments
\RequirePackage{comment}

% The Colours
\RequirePackage{xcolor}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

% --- Load Modules in Order ---

% 1. Foundational packages, data, and configuration
\RequirePackage{bsk_latex_lib/bsk_section_colours} % Loads colors and section names
\RequirePackage{bsk_latex_lib/bsk_sections} % Defines the section database
\RequirePackage{bsk_latex_lib/bsk_config}   % Provides \setupProtokoll

% 2. Layout and basic structure
\RequirePackage{bsk_latex_lib/bsk_layout}    % Defines headers, footers, borders
\RequirePackage{bsk_latex_lib/bsk_structure} % Defines the \paragraf command

% 3. Functional modules for content generation
\RequirePackage{bsk_latex_lib/bsk_formalia}  % Attendance, signatures, person database
\RequirePackage{bsk_latex_lib/bsk_decisions} % Decision logging and formatting
\RequirePackage{bsk_latex_lib/bsk_meeting}   % Meeting procedure commands

% --- Master Commands ---

% A single command to clear all lists for a new document.
\NewDocumentCommand{\clearAll}{ }
{
  \clearAttendance
  \clearDecisions
}

% A single command to print the decision summary and signatures at the end.
\NewDocumentCommand{\printClosing}{ }
{
  \printBeslut
  \signatures
}
