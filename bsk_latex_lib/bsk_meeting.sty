% bsk_latex_lib/bsk_meeting.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/bsk_meeting}[2025/09/27 v1.8 Meeting Module (Closing Command)]

\RequirePackage{xparse}
\ExplSyntaxOn

% --- Internal Formalia Point Commands ---
\NewDocumentCommand{\moetetsOppnande}{}{\paragraf{Mötet~öppnas}{Mötesordförande~\getOfficial{ordf_name}~förklarade~mötet~öppnat.}}
\NewDocumentCommand{\valAvJusterare}{}{\paragraf{Val~av~mötesordförande,~mötessekreterare~samt~justeringsperson.}{\Beslut*{att~välja~\getOfficial{ordf_name}~till~mötesordförande.}{att~välja~\getOfficial{sekr_name}~till~mötessekreterare.}{att~välja~\getOfficial{just_name}~till~justeringsperson.}}}
\NewDocumentCommand{\moetetsBehorigaUtlysande}{}{\paragraf{Fråga~om~mötets~behöriga~utlysande~och~beslutsmässighet}{\Beslut*{anse~mötet~behörigt~utlyst.}{anse~mötet~vara~beslutsmässigt~med~minst~hälften~av~ordinarie~ledamöter~närvarande.}}}
\NewDocumentCommand{\yttrandeOchRostratt}{}{\paragraf{Yttranderätt~och~rösträtt}{Samtliga~närvarande~medlemmar~i~Blekinge~studentkår~hade~närvaro-~samt~yttranderätt.~Ordinarie~styrelse~hade~rösträtt~vid~beslut.}}
\NewDocumentCommand{\faststallandeAvForedragningslista}{O{}}{\paragraf{§5}{Fastställande~av~dagordning}{Dagordningen~fastställdes~enligt~utsänt~förslag.}}
\NewDocumentCommand{\faststallandeAvForegaendeProtokoll}{O{}}{\paragrag{§6}{Fastställande~av~föregående~mötesprotokoll}{Föregående~mötesprotokoll~lades~till~handlingarna.}}

% --- The Main Automated Formalia Command ---
\NewDocumentCommand{\printFormalia}{}
{
  \present
  \absent
  \subsection*{Formalia}
  \moetetsOppnande
  \valAvJusterare
  \moetetsBehorigaUtlysande
  \yttrandeOchRostratt
  \faststallandeAvForedragningslista
  \faststallandeAvForegaendeProtokoll
  \section*{Ärenden}
}

% --- New command to print closing matter ---
\NewDocumentCommand{\printClosing}{}
 {
  \section*{Avslutning}
  \printDecisionSummary
  \signatures
 }

\ExplSyntaxOff
