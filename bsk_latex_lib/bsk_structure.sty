\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/bsk_structure}[2025/09/27 v1.0 Structure Module]

\RequirePackage{float} % For the [H] option to place tables exactly here
\RequirePackage{array}
\newcounter{paragrafcounter}
\newcommand{\paragraf}[2]{
  \stepcounter{paragrafcounter}
  \begin{table}[H]
  {\renewcommand\arraystretch{1.25}
  \begin{tabular}{ p{0.5cm} p{4cm} p{10cm}}
  §\theparagrafcounter & \raggedright{#1} & \raggedright{#2}
  \end{tabular}}
  \end{table}
}
