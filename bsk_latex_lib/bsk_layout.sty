% bsk_latex_lib/bsk_layout.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib/bsk_layout}[2025/09/27 v1.2 Layout Module]

% Language and font packages
\RequirePackage[swedish, english]{babel}
\RequirePackage{times}
\RequirePackage[utf8]{inputenc}

% Layout and geometry packages
\RequirePackage{geometry}
\geometry{a4paper, portrait, lmargin=3cm, rmargin=3cm, tmargin=4cm}
\RequirePackage{lastpage}
\RequirePackage{fancyhdr}
\RequirePackage{array}
\RequirePackage{graphicx}

% Border packages
\RequirePackage{background}
\RequirePackage{tikz}
\usetikzlibrary{calc}

% --- Header and Footer Setup ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\lhead{Protocol from the \meetingSektion{} meeting in \meetingPlats}
\rhead{\meetingDatum}
\rfoot{Adjusted: \underline{\qquad\quad}\qquad\thepage \: (\pageref{LastPage})}
\cfoot{\includegraphics[width=2.5cm]{\meetingLogga}}

% --- Page Border Setup ---
\newcommand{\SetPageBorder}{
  \backgroundsetup{color=black,scale=1,opacity=1,angle=0,
  contents={\tikz\draw[line width=3pt,draw=\meetingFarg]
    ( $ (current page.south east) +(-13,2) $ ) -- ( $ (current page.south west) +(1.75 ,2) $ )
    ( $ (current page.south west) +(2,1) $ ) -- ( $ (current page.north west) +(2,-1.75) $ )
    ( $ (current page.north west) +(1.75,-2) $ ) -- ( $ (current page.north east) -(2,2) $ ); }}
}

% Apply the border at the beginning of the document
\AtBeginDocument{\SetPageBorder}
