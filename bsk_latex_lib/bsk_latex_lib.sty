%%%% This is mostly importing important packages and set default settings.The comments are to explain what it is used for %%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bsk_latex_lib}[2025/09/27 v1.2 BSK Protocol Package (Fixes)]

% --- Load Modules in Order ---

\RequirePackage{bsk_latex_lib/preamble}

% Foundational packages, data, and configuration
\RequirePackage{bsk_latex_lib/sections/section_colours} % Loads colors and section names
\RequirePackage{bsk_latex_lib/sections/sections}        % Defines the section database
\RequirePackage{bsk_latex_lib/data/config}          % Provides \setupProtokoll

% Layout and basic structure
\RequirePackage{bsk_latex_lib/layout/layout}          % Defines headers, footers, borders
\RequirePackage{bsk_latex_lib/layout/structure}       % Defines the \paragraf command

% Functional modules for content generation
\RequirePackage{bsk_latex_lib/commands/formalia}        % Attendance, signatures, person database
\RequirePackage{bsk_latex_lib/commands/decisions}       % Decision logging and formatting
\RequirePackage{bsk_latex_lib/commands/meeting}         % Meeting procedure commands

% --- Master Commands ---

\NewDocumentCommand{\clearAll}{ }
{
  \clearAttendance
  \clearDecisions
}

